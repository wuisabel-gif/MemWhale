#compdef mw
# zsh completion for mw (MemoryWhale).
# Install: copy this file (named _mw) into a directory on your $fpath, e.g.
#   mkdir -p ~/.local/share/zsh/site-functions
#   cp _mw ~/.local/share/zsh/site-functions/_mw
#   echo 'fpath=(~/.local/share/zsh/site-functions $fpath)' >> ~/.zshrc
#   autoload -Uz compinit && compinit

_mw() {
  local -a subcmds
  subcmds=(
    'list:list recorded sessions'
    'show:print the full transcript of a session'
    'mark:bookmark the current debugging moment'
    'remember:save a lesson or conclusion for later'
    'memory:retire, replace, or compact memory'
    'rm:delete a saved session or command run'
    'prune:delete empty auto-recorded sessions'
    'audit:inspect capture policy and retained volume'
    'share:write a self-contained HTML page to send to someone'
    'discard:inside a recording, throw the current session away'
    'replay:rerun a saved command run'
    'demo:seed a small demo dataset'
    'export:export memory to a bundle (Markdown + JSON + SQLite)'
    'import:merge another machine'\''s exported memory'
    'push:send this machine'\''s memory to a teammate over SSH'
    'pull:copy another machine'\''s memory here and merge it'
    'context:print a compact digest for an AI agent'
    'agent:export a session as text to paste into an agent'
    'ask:package the last failure for ChatGPT/Claude (clipboard)'
    'search:search commands, output, notes, and transcripts'
    'explain:why this memory ranks: per-signal breakdown'
    'link:link two memories (typed edge)'
    'unlink:remove a typed edge between two memories'
    'links:show a memory'\''s linked neighbors in both directions'
    'pet:snapshot your memory whale'\''s growth (--watch animates)'
    'tui:interactive terminal browser'
    'sync-mempalace:mirror memories into MemPalace'
    'git-fix:diagnose the last failed git command'
    'github:explicit read-only GitHub context (no automatic save)'
    'doctor:check the install, shell hooks, MCP server, and Claude/Rho integrations'
    'global:auto-record every new terminal (on/off/status)'
    'status:show the effective capture mode for this directory'
    'hooks:install or remove shell auto-record hooks'
    'integrate:configure client memory access, hooks, and skills'
  )

  if (( CURRENT == 2 )); then
    _arguments \
      '--live[autosave the session to SQLite while running]' \
      '--notes[attach a note to this session]:note:' \
      '(-h --help)'{-h,--help}'[show help]' \
      '(-V --version)'{-V,--version}'[print the installed version]' \
      '*::command:->cmds'
    _describe -t commands 'mw command' subcmds
    return
  fi

  case ${words[2]} in
    global)
      _values 'state' on off status
      ;;
    memory)
      if (( CURRENT == 3 )); then
        _values 'action' stale supersede compact
      elif [[ ${words[3]} == compact ]]; then
        _arguments \
          '--apply[apply the previewed compaction policy]' \
          '--min-session-bytes[minimum transcript bytes]:bytes:' \
          '--stale-days[age threshold]:days:' \
          '--max-output-bytes[retained command output bound]:bytes:' \
          '(-h --help)'{-h,--help}'[show help]'
      fi
      ;;
    github)
      (( CURRENT == 3 )) && _values 'action' context
      ;;
    hooks)
      case ${words[3]} in
        install|uninstall|remove) _values 'shell' pwsh ;;
        *) _values 'action' install uninstall remove ;;
      esac
      ;;
    pet)
      _arguments '--watch[animate the whale whose mood reflects your memory store]'
      ;;
    integrate)
      case ${words[3]:-} in
        --revert) ;;
        claude|claude-code)
          if (( CURRENT == 4 )); then
            _values 'option' --revert
          fi
          ;;
        rho)
          _arguments \
            '--revert[remove the integration without deleting memory]' \
            '--http[use mw-serve POST /mcp instead of stdio]::MCP URL:' \
            '--token[HTTP MCP token; requires --http]:token:'
          ;;
        hermes) ;;
      esac
      if (( CURRENT == 3 )); then
        _values 'target' claude claude-code hermes rho
      fi
      ;;
    sync-mempalace)
      _arguments \
        '--wing[name of the MemPalace wing]:wing:' \
        '--limit[max memories to sync]:count:' \
        '--dry-run[print the plan without contacting the server]'
      ;;
    show)
      local -a ids
      ids=(${(f)"$(mw list 2>/dev/null | sed -n 's/^#\([0-9][0-9]*\).*/\1/p')"})
      _describe -t ids 'session id' ids
      ;;
    rm|share)
      _values 'kind' session command
      ;;
    import)
      _files
      ;;
    push|pull)
      _ssh_hosts 2>/dev/null || _hosts
      ;;
    context)
      _arguments \
        '--last-error[only the most recent failure]' \
        '--limit[max results]:count:'
      ;;
    search)
      _arguments \
        '--explain[show ranking reasons]' \
        '--project[scope by project]:project:' \
        '--machine[scope by machine]:machine:' \
        '--since[relative time window]:duration:' \
        '*:query or filter:_mw_search_filters'
      ;;
    ask)
      _arguments \
        '--chat[which chat to open]:target:(chatgpt claude gemini)' \
        '--session[append the tail of the current session]' \
        '--no-open[do not open the browser]'
      ;;
  esac
}

_mw_search_filters() {
  local -a filters
  filters=(
    'agent\:claude:Claude command provenance'
    'agent\:rho:Rho command provenance'
    'agent\:terminal:NULL provenance (manual or legacy)'
    'source\:command:command source'
    'source\:session:session source'
    'source\:note:note source'
    'source\:document:document source'
    'source\:conversation:conversation source'
    'tag\::tag filter'
    'before\::before YYYY-MM-DD'
    'after\::after YYYY-MM-DD'
    'limit\::result limit'
  )
  _describe -t filters 'search filter' filters
}

_mw "$@"
